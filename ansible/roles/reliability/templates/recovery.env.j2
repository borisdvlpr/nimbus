# Rendered by the reliability role from group_vars/all.yml. Consumed by nimbus-recovery.sh.
CLUSTER_NAME={{ kind.cluster_name }}
NODE_CONTAINER={{ kind.cluster_name }}-control-plane
KUBECONFIG=/root/.kube/config
CLUSTER_CONFIG={{ nimbus_conf_dir }}/kind-cluster.yaml
GRACE_SECONDS={{ recovery.grace_seconds | default(300) }}
UNATTENDED={{ 'true' if (recovery.unattended | bool) else 'false' }}

# Used only when UNATTENDED=true (keys are persisted by the reliability role)
AGE_KEY={{ nimbus_secrets_dir }}/age.key
DEPLOY_KEY={{ nimbus_secrets_dir }}/deploy.key
GIT_AUTH={{ bootstrap.git_auth }}
GIT_URL={{ flux.git_url }}
GIT_BRANCH={{ flux.git_branch }}
GIT_PATH={{ flux.cluster_path }}
GIT_HOST={{ flux.git_host }}
FLUX_COMPONENTS=source-controller,kustomize-controller,helm-controller
